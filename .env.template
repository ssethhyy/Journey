# Journey: your own API keys and signing details.
#
# Copy this file to `.env` in the same folder and fill in your values:
#
#   cp .env.template .env        (macOS / Linux / Git Bash)
#   copy .env.template .env      (Windows cmd)
#
# `.env` is listed in .gitignore, so your keys stay on your computer. The repository ships with NO keys: everyone
# who builds Journey uses their own. NEVER put real keys in this template, in the source, or in a commit.
#
# Everything is optional. Without keys the app still builds and the tests still pass; you just get "missing
# credentials" messages instead of live data. Keys can also be pasted in the app under Settings -> API access.

# --- PTV Timetable API (live departures, stops, routes, disruptions) ---
# Free. Request a key from Public Transport Victoria; they email you both values:
#   https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
PTV_DEV_ID=
PTV_API_KEY=

# --- Mapbox (the Map tab and the journey, trip and route maps) ---
# Use a PUBLIC token (starts with "pk."), never a secret one ("sk."):
#   https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# --- Transport Victoria Open Data (crowding, optional) ---
# Free key from the Open Data portal (create an account, then generate an API key):
#   https://opendata.transport.vic.gov.au
VIC_OPENDATA_KEY=

# --- OpenWeatherMap (the weather on For You, optional) ---
# Free key: create an account, then copy a key from "API keys" (new keys can take an hour or two to start working):
#   https://home.openweathermap.org/users/sign_up
# Release builds you publish include it, so people who download them get the weather without a key of their own.
# Without one, people can paste their own key, or pick Open-Meteo (no key), in the Greeting widget's settings.
WEATHER_API_KEY=

# --- Release signing (optional: your own key for release builds) ---
# Create a keystore OUTSIDE this folder, for example:
#   keytool -genkeypair -v -keystore "D:\keys\journey-release.jks" -alias journey -keyalg RSA -keysize 4096 -validity 10000
# Back up the .jks file and both passwords: without them you can't ship updates that install over existing copies.
# Leave these empty and release builds are signed with the debug key.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
