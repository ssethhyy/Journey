# Copy this file to `local.properties` (same folder) and fill in your own values.
#
#   cp local.properties.example local.properties        (macOS / Linux / Git Bash)
#   copy local.properties.example local.properties      (Windows cmd)
#
# `local.properties` is listed in .gitignore, so your keys stay on your machine.
# NEVER put real keys in this example file, in the source, or in a commit.
#
# Android Studio writes `sdk.dir` for you. If you build from the command line without it,
# either uncomment one of these or set the ANDROID_HOME environment variable:
#   sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk
#   sdk.dir=/Users/you/Library/Android/sdk
#   sdk.dir=/home/you/Android/Sdk

# --- PTV Timetable API (live departures, stops, routes, disruptions) ---
# Free. Request a key from Public Transport Victoria, they email you both values:
#   https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
ptv.devId=
ptv.apiKey=

# --- Mapbox (the map tab, trip map and journey map) ---
# Use a PUBLIC token (starts with "pk."), never a secret one ("sk."):
#   https://account.mapbox.com/access-tokens/
mapbox.accessToken=

# --- Transport Victoria Open Data (OPTIONAL: how busy a service and its carriages are) ---
# Free key from the Open Data portal (create an account, then generate an API key):
#   https://opendata.transport.vic.gov.au
# Leave empty to skip crowding. You can also paste the key in the app under Settings -> API access.
vic.opendata.key=

# --- Release signing (OPTIONAL: your own key for release builds) ---
# Create a keystore OUTSIDE this folder, e.g.:
#   keytool -genkeypair -v -keystore "D:\keys\journey-release.jks" -alias journey -keyalg RSA -keysize 4096 -validity 10000
# Back up the .jks file and both passwords: without them you can't ship updates that install over existing copies.
# Leave these empty and release builds use the debug key.
release.storeFile=
release.storePassword=
release.keyAlias=
release.keyPassword=
